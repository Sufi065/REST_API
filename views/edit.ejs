<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit page</title>
</head>
<body>
    <h3>Edit Page!</h3>
    <p>Post id: <%= post.id %></p>
    <div>
        <h3>@<%= post.username %></h3>
        <form  method="post" action="/posts/<%= post.id %>?_method=PATCH">
            <textarea name="content"><%= post.content %></textarea>
            <button>Submit</button>
        </form>
        
    </div>
    
</body>
</html>