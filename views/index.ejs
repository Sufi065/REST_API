<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RESTful API</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    
    <h2>Quara</h2>
    <%for(post of posts){%>
        <div>
            <p>Post id: <%= post.id %></p>
            <p><b>@<%= post.username %></b></p>
            <p><%= post.content %></p>
            <a href="http://localhost:8080/posts/<%= post.id %>">Show post in deatial!</a>
            <a href="http://localhost:8080/posts/<%= post.id %>/edit">Edit</a>
            <form method="post" action="/posts/<%= post.id %>?_method=DELETE">
                 <button>Faaaa!!</button>
            </form>
        </div>
    <%}%>

    <a href="http://localhost:8080/posts/new">Create a new post!</a>
    
</body>
</html>